# Reale Konfiguration: enthält fahrzeugspezifische Daten und wird nicht
# versioniert. Nur die *.example.yaml gehören ins Repository.
config/hardware/*.yaml
!config/hardware/*.example.yaml
config/vehicle/*.yaml
!config/vehicle/*.example.yaml
# Ausnahme: die Fahrzeugbeschreibung selbst. Sie sagt, WELCHE Funktionen das
# Fahrzeug hat und wie groß die Tanks sind — das ist keine schützenswerte
# Information, und ohne sie ist das System nicht startbar.
# Hardwareadressen und Zugangsdaten stehen ausdrücklich NICHT hier, sondern
# in config/hardware/ — und das bleibt ungetrackt.
!config/vehicle/vehicle.yaml
config/environments/*.local.yaml

# Secrets gehören niemals ins Repository (Kapitel 15 §49/§50)
.env
.env.*
!.env.example
*.key
*.pem

# Daten und Laufzeit
*.db
*.db-wal
*.db-shm
data/
logs/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Gebaute Oberfläche. Ein Bauartefakt gehört nicht in die Versionsverwaltung —
# es entsteht reproduzierbar aus den Quellen ('npm run build'). Fehlt es,
# startet das Backend trotzdem und weist im Log darauf hin.
backend/kehleros/api/static/

# System
.DS_Store

# Zwischenstände der Demo. Der Bauweg gehört ins Repository, die Zwischenstände
# nicht: `dist-demo/` ist ein Build-Ergebnis, `recording.json` die Rohaufnahme.
# Die fertige Datei `kehler-os-demo.html` ist dagegen ausdrücklich versioniert —
# sie ist das, was man weitergibt, und soll ohne Werkzeuge erreichbar sein.
frontend/dist-demo/
tools/demo/recording.json
tools/demo/kehler-os-demo.fragment.html

# Der Erkundungsbericht des OPC-UA-Servers. Er enthält Bausteinnamen, die
# Struktur der Anlage und aktuelle Messwerte — das gehört zum Fahrzeug wie die
# Hardwareadressen (Kapitel 17 §48). Das Werkzeug selbst ist versioniert, sein
# Ergebnis nicht. Ebenso die Client-Zertifikate für die OPC-UA-Verbindung.
tools/opcua/opcua-bericht.txt
tools/opcua/*.der
tools/opcua/*.pem

# Das 3D-Modell des Fahrzeugs. Es gehört zum Fahrzeug wie die Hardwareadressen
# und wird deshalb nicht versioniert: eine große Binärdatei, die je nach
# Fahrzeug eine andere ist. Ohne sie greift die aus Code gebaute Darstellung
# (ADR 0008) — siehe Punkt K2.
config/vehicle/model.glb
